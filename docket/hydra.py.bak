"""HydraDB client over the node's JSON HTTP API. Standard library only.

Written against a response envelope that was observed, not assumed:

    {"query_id":"http-query-2","columns":["id"],
     "rows":[[{"type":"vertex_id","value":2}]],
     "read_epoch":1,"next_cursor":null,
     "bookmark":"sgk:1:64656661756c74:...:1"}

Three properties of that envelope drive this module:

1. `rows` is a list of ROWS, each row a list of typed CELL OBJECTS matched by
   position to `columns`. Not a list of dicts. Every value has to be unwrapped
   and the type tag kept, so `value()` and `raw` are both available.

2. `bookmark` is a causal-consistency token. Ingest writes and then reads; a
   read that does not carry the write's bookmark may legitimately observe an
   older snapshot. The client threads the newest bookmark through every
   following request so that cannot happen quietly.

3. `next_cursor` means the answer is incomplete. A client that ignores it
   returns a short result that looks complete, which is the exact class of bug
   this project exists to refuse. Pagination is therefore attempted, and if the
   server rejects the attempted shape the client RAISES rather than handing
   back a truncated page.

Bookmark and cursor request shapes are not documented in the repo README, so
both are treated as unverified until `tools/probe.py` measures them against a
live node. `capabilities()` reports what is known versus what is assumed.
"""
from __future__ import annotations

import json
import time
import urllib.error
import urllib.request

DEFAULT_BASE = "http://127.0.0.1:8443"
DEFAULT_GRAPH = "default"
DEFAULT_NAMESPACE = "default"
DEFAULT_CELL = "cell-0"

# The node logs runtime_limit_ms 30000 on its own spans, so a query that runs
# longer than this is killed server side. Keep the client's socket timeout
# above it so a server-side deadline surfaces as a server error with a reason
# rather than as a client socket timeout with none.
SERVER_DEADLINE_SECONDS = 30
DEFAULT_TIMEOUT = 35


class HydraError(RuntimeError):
    """Any failure that came from the server or the transport."""


class HydraTruncated(HydraError):
    """The server had more rows and the client could not fetch them.

    Never downgraded to a warning. A partial answer presented as a whole
    answer is worse than an error.
    """


def lit(value) -> str:
    """Render a Python value as a Cypher literal.

    Used because parameter support is unverified on this server. Strings are
    single quoted with backslash escapes; None becomes null; bools become
    true/false; numbers pass through. Anything else is rejected loudly instead
    of being coerced into a string that would silently change meaning.
    """
    if value is None:
        return "null"
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, int) and not isinstance(value, bool):
        return str(value)
    if isinstance(value, float):
        if value != value or value in (float("inf"), float("-inf")):
            raise ValueError(f"cannot render {value!r} as a Cypher literal")
        return repr(value)
    if isinstance(value, str):
        out = (value.replace("\\", "\\\\")
                    .replace("'", "\\'")
                    .replace("\n", "\\n")
                    .replace("\r", "\\r")
                    .replace("\t", "\\t"))
        return f"'{out}'"
    raise TypeError(f"no Cypher literal for {type(value).__name__}")


def cell_value(cell):
    """Unwrap one typed cell object to a plain Python value.

    Unknown type tags are NOT guessed at: the wrapper is returned intact so a
    caller can see what arrived instead of receiving a plausible-looking None.
    """
    if isinstance(cell, dict) and "value" in cell:
        return cell["value"]
    return cell


class QueryResult:
    def __init__(self, payload: dict, pages: int = 1):
        self.raw = payload
        self.columns: list[str] = payload.get("columns") or []
        self.raw_rows: list[list] = payload.get("rows") or []
        self.bookmark = payload.get("bookmark")
        self.read_epoch = payload.get("read_epoch")
        self.next_cursor = payload.get("next_cursor")
        self.query_id = payload.get("query_id")
        self.pages = pages

    @property
    def rows(self) -> list[dict]:
        """Rows as column-keyed dicts of plain values."""
        out = []
        for row in self.raw_rows:
            out.append({c: cell_value(v) for c, v in zip(self.columns, row)})
        return out

    def scalar(self, default=None):
        """The single value of a one-row one-column result.

        Returns `default` when there are no rows. Raises when the shape is
        anything other than one column, because silently taking the first of
        several columns is how the wrong number ends up in a report.
        """
        if not self.raw_rows:
            return default
        if len(self.columns) != 1:
            raise HydraError(
                f"scalar() needs exactly one column, got {self.columns}")
        return cell_value(self.raw_rows[0][0])

    def __len__(self) -> int:
        return len(self.raw_rows)

    def __repr__(self) -> str:
        return (f"<QueryResult {len(self.raw_rows)} rows "
                f"cols={self.columns} pages={self.pages}>")


class HydraClient:
    def __init__(self, base_url: str = DEFAULT_BASE, token: str = "",
                 graph: str = DEFAULT_GRAPH,
                 namespace: str = DEFAULT_NAMESPACE,
                 cell: str = DEFAULT_CELL,
                 timeout: float = DEFAULT_TIMEOUT,
                 send_bookmark: bool = True,
                 cursor_key: str = "cursor",
                 opener=None):
        self.base_url = base_url.rstrip("/")
        self.token = token
        self.graph = graph
        self.namespace = namespace
        self.cell = cell
        self.timeout = timeout
        self.send_bookmark = send_bookmark
        self.cursor_key = cursor_key
        self.bookmark: str | None = None
        self.queries = 0
        self.pages_fetched = 0
        self._opener = opener or urllib.request.urlopen

    @property
    def url(self) -> str:
        return f"{self.base_url}/v1/graphs/{self.graph}/query"

    def _post(self, body: dict) -> dict:
        data = json.dumps(body).encode()
        req = urllib.request.Request(self.url, data=data, method="POST", headers={
            "Authorization": f"Bearer {self.token}",
            "X-Graph-Namespace": self.namespace,
            "Content-Type": "application/json",
        })
        try:
            with self._opener(req, timeout=self.timeout) as r:
                text = r.read().decode()
        except urllib.error.HTTPError as e:
            detail = e.read()[:400]
            raise HydraError(f"http {e.code}: {detail!r}") from None
        except urllib.error.URLError as e:
            raise HydraError(f"transport: {e.reason}") from None
        if not text.strip():
            raise HydraError("empty response body")
        try:
            return json.loads(text)
        except ValueError:
            raise HydraError(f"response was not JSON: {text[:200]!r}") from None

    def query(self, cypher: str, follow_cursor: bool = True) -> QueryResult:
        """Run one Cypher statement and return the whole answer.

        The bookmark from every response is retained and sent with the next
        request, so a read issued after a write observes that write.
        """
        body = {"cell_id": self.cell, "query": cypher}
        if self.send_bookmark and self.bookmark:
            body["bookmark"] = self.bookmark
        payload = self._post(body)
        self.queries += 1
        self.pages_fetched += 1
        result = QueryResult(payload)
        if result.bookmark:
            self.bookmark = result.bookmark

        pages = 1
        while result.next_cursor:
            if not follow_cursor:
                raise HydraTruncated(
                    f"server returned next_cursor after {len(result.raw_rows)} "
                    f"rows and follow_cursor is off; the answer is incomplete")
            page = self._next_page(result.next_cursor)
            pages += 1
            self.pages_fetched += 1
            result.raw_rows.extend(page.raw_rows)
            result.next_cursor = page.next_cursor
            if page.bookmark:
                self.bookmark = page.bookmark
            if pages > 10000:
                raise HydraTruncated("pagination did not terminate")
        result.pages = pages
        return result

    def _next_page(self, cursor) -> QueryResult:
        body = {"cell_id": self.cell, self.cursor_key: cursor}
        if self.send_bookmark and self.bookmark:
            body["bookmark"] = self.bookmark
        try:
            payload = self._post(body)
        except HydraError as e:
            raise HydraTruncated(
                f"the server paged the result but the request shape for "
                f"fetching page 2 was rejected ({e}); rows already received "
                f"are NOT the whole answer. Run tools/probe.py to learn the "
                f"real cursor shape.") from None
        return QueryResult(payload)

    def wait_ready(self, seconds: float = 60, interval: float = 1.0) -> float:
        """Block until the node answers a trivial query.

        A freshly started container opens its listeners before SlateDB and the
        writer lease are ready, so the first query after `docker start` can
        fail on a node that is merely still waking up.
        """
        deadline = time.time() + seconds
        last = None
        started = time.time()
        while time.time() < deadline:
            try:
                self.query("RETURN 1 AS ok")
                return time.time() - started
            except HydraError as e:
                last = e
                time.sleep(interval)
        raise HydraError(f"node not ready after {seconds}s: {last}")

    def capabilities(self) -> dict:
        """What this client believes about the server, and on what basis."""
        return {
            "response_envelope": "measured",
            "typed_cells": "measured",
            "bookmark_returned": "measured",
            "bookmark_accepted_in_request": "assumed",
            "cursor_request_shape": "assumed",
            "query_parameters": "unknown",
            "server_deadline_seconds": SERVER_DEADLINE_SECONDS,
        }
